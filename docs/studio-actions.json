 "selection": {
  "about": "What the person selected on the Problems, Plan and Change pages or on a map; resolved to card ids on the server from the Studio data of the latest check.",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "card",
      "cards",
      "group",
      "step"
     ]
    },
    "cards": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
     },
     "maxItems": 500
    },
    "group": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "by",
      "value"
     ],
     "properties": {
      "by": {
       "enum": [
        "area",
        "severity",
        "component",
        "gap",
        "operation"
       ]
      },
      "value": {
       "type": "string"
      }
     }
    },
    "step": {
     "type": "string"
    }
   }
  },
  "resolve": {
   "card": "cards[0], one id",
   "cards": "the ids as given, at most 500",
   "group.area": "cards.json cards whose category equals value",
   "group.severity": "cards.json cards whose severity equals value",
   "group.component": "gaps.json: the cards of every gap whose component equals value",
   "group.gap": "gaps.json: the cards of the gap whose id equals value",
   "group.operation": "operations.json: the cards of the operation whose id equals value",
   "step": "cards.json cards whose milestone equals the step id"
  },
  "rules": [
   "Only open cards are run; a card already done, resolved, skipped or on a branch is reported and left out.",
   "An empty selection is refused with the reason, never run.",
   "A selection that needs a section the check did not write is refused with its coverage state."
  ]
 },
 "lifecycle": {
  "states": {
   "queued": {
    "en": "Waiting its turn",
    "ar": "ينتظر دوره"
   },
   "running": {
    "en": "Running",
    "ar": "يشتغل"
   },
   "paused": {
    "en": "Paused",
    "ar": "متوقف مؤقتًا"
   },
   "waiting_for_person": {
    "en": "Waiting for your answer",
    "ar": "ينتظر جوابك"
   },
   "done": {
    "en": "Done",
    "ar": "انتهى"
   },
   "failed": {
    "en": "Did not finish",
    "ar": "ما اكتمل"
   },
   "stopped": {
    "en": "Stopped",
    "ar": "أوقفته"
   }
  },
  "terminal": [
   "done",
   "failed",
   "stopped"
  ],
  "transitions": [
   [
    "queued",
    "running",
    "the queue reaches it"
   ],
   [
    "queued",
    "stopped",
    "stop"
   ],
   [
    "running",
    "paused",
    "pause (the assistant process is suspended; a direct call finishes its current step)"
   ],
   [
    "paused",
    "running",
    "resume"
   ],
   [
    "paused",
    "stopped",
    "stop"
   ],
   [
    "running",
    "waiting_for_person",
    "a question event"
   ],
   [
    "waiting_for_person",
    "running",
    "the answer (the assistant session is resumed with it)"
   ],
   [
    "waiting_for_person",
    "stopped",
    "stop"
   ],
   [
    "running",
    "done",
    "the result event"
   ],
   [
    "running",
    "failed",
    "an error the run cannot go past, or the process died"
   ],
   [
    "running",
    "stopped",
    "stop"
   ],
   [
    "failed",
    "queued",
    "retry (a new attempt of the same run, same selection)"
   ],
   [
    "stopped",
    "queued",
    "retry"
   ],
   [
    "done",
    "done",
    "accept or undo record their outcome on the run; the state stays done"
   ]
  ],
  "one_at_a_time": "One run per project is running or waiting_for_person at a time; EAOS keeps one open batch per project. The rest queue in order.",
  "restart": "Runs, their events and the queue are on disk (~/.eaos/runs/). After a server restart a run that was running is marked failed with the reason unless its process is still alive, in which case it is followed again; queued runs keep their order."
 },
 "events": {
  "envelope": {
   "type": "object",
   "required": [
    "seq",
    "id",
    "run",
    "at",
    "kind",
    "text",
    "data",
    "prev",
    "hash"
   ],
   "properties": {
    "seq": {
     "type": "integer",
     "minimum": 1,
     "description": "Gapless per run; the SSE id, so Last-Event-ID replays exactly."
    },
    "id": {
     "type": "string",
     "description": "<run>-<seq>"
    },
    "run": {
     "type": "string"
    },
    "at": {
     "type": "string",
     "format": "date-time"
    },
    "kind": {
     "enum": [
      "state",
      "step",
      "read",
      "edit",
      "check",
      "screenshot",
      "progress",
      "question",
      "answer",
      "result",
      "error",
      "action",
      "say"
     ]
    },
    "text": {
     "type": "object",
     "required": [
      "en",
      "ar"
     ],
     "properties": {
      "en": {
       "type": "string"
      },
      "ar": {
       "type": "string"
      }
     }
    },
    "data": {
     "type": "object"
    },
    "detail": {
     "type": [
      "string",
      "null"
     ],
     "description": "The technical detail, one tap away; never a secret."
    },
    "prev": {
     "type": "string",
     "description": "hash of the previous event, 64 zeros for the first"
    },
    "hash": {
     "type": "string",
     "description": "sha256(prev + canonical JSON of the event without hash), as docs D-platform 2.5"
    }
   }
  },
  "kinds": {
   "state": {
    "data": {
     "from": "state",
     "to": "state",
     "why": "string"
    }
   },
   "step": {
    "data": {
     "tool": "EAOS tool name or null",
     "card": "card id or null"
    }
   },
   "read": {
    "data": {
     "path": "project-relative path",
     "tool": "tool that read it"
    }
   },
   "edit": {
    "data": {
     "card": "card id",
     "paths": [
      "project-relative path"
     ],
     "diff": "unified diff, at most 64 KiB",
     "kept": "bool or null"
    }
   },
   "check": {
    "data": {
     "name": "the gate or check",
     "passed": "bool",
     "summary": "string"
    }
   },
   "screenshot": {
    "data": {
     "route": "string",
     "viewport": "string",
     "when": "before|after",
     "path": "path in the outputs folder"
    }
   },
   "progress": {
    "data": {
     "batch": "batch number or null",
     "done": "int",
     "total": "int"
    }
   },
   "question": {
    "data": {
     "id": "question id",
     "text": {
      "en": "string",
      "ar": "string"
     },
     "options": [
      {
       "id": "string",
       "label": {
        "en": "string",
        "ar": "string"
       }
      }
     ],
     "recommendation": "option id or null",
     "why": "which of the three EAOS questions, or another choice"
    }
   },
   "answer": {
    "data": {
     "question": "question id",
     "option": "option id or null",
     "text": "free text or null",
     "by": "person"
    }
   },
   "result": {
    "data": {
     "branch": "eaos/wave-N or null",
     "diff_stat": {
      "files": "int",
      "insertions": "int",
      "deletions": "int"
     },
     "tests": {
      "passed": "bool or null",
      "summary": "string"
     },
     "cards_closed": [
      "card id"
     ],
     "indicators": [
      {
       "id": "string",
       "before": "number|null",
       "after": "number|null"
      }
     ],
     "answer": "the assistant final words, for explain, verify and plan"
    }
   },
   "error": {
    "data": {
     "reason": "string",
     "what_now": {
      "en": "string",
      "ar": "string"
     },
     "recoverable": "bool"
    }
   },
   "action": {
    "data": {
     "action": "action id",
     "by": "person|studio",
     "arguments": "the arguments, without project, edits, spec or proposal bodies"
    }
   },
   "say": {
    "data": {
     "words": "what the assistant told the person, in its own words"
    }
   }
  },
  "rules": [
   "Every action the API accepts is logged as an action event before it runs.",
   "Plain text in both languages on every event; the technical detail is optional and one tap away.",
   "No secret, no absolute home path and no environment value is ever written to an event."
  ]
 },
