 },
 "endpoints": [
  {
   "method": "GET",
   "path": "/api/session",
   "does": "The CSRF token for this page, the server mode (live), the assistants detected."
  },
  {
   "method": "GET",
   "path": "/api/actions",
   "does": "This contract, as served (actions, verbs, lifecycle)."
  },
  {
   "method": "GET",
   "path": "/api/assistants",
   "does": "Each adapter: installed, logged in, version."
  },
  {
   "method": "POST",
   "path": "/api/actions/<id>/preview",
   "body": "{inputs?, selection?, verb?, assistant?}",
   "does": "The preview payload; never changes anything. <id> is an action, or a verb (fix, verify, explain, plan) when the body has a selection."
  },
  {
   "method": "POST",
   "path": "/api/runs",
   "body": "{action, inputs?, selection?, verb?, assistant?, confirm?}",
   "does": "Queues a run; returns {run}. A verb over a selection is posted with `verb` and `selection` (and `action` = the verb); a read-only action answers at once, its result in run.result, and stays out of the history unless ?all=1. Refused with 403 {needs: \"confirm\"} when the run changes code or cannot be undone and the confirm token is missing."
  },
  {
   "method": "GET",
   "path": "/api/runs",
   "does": "Every run, newest first, with the queue order; ?q= searches the label, cards and outcome; ?state= filters."
  },
  {
   "method": "GET",
   "path": "/api/runs/<id>",
   "does": "One run with its last state, its result and its open question."
  },
  {
   "method": "GET",
   "path": "/api/runs/<id>/events",
   "does": "SSE: every event of the run from Last-Event-ID (or ?after=) on, then live; a heartbeat comment every 15 s; ends after a terminal state."
  },
  {
   "method": "POST",
   "path": "/api/runs/<id>/pause"
  },
  {
   "method": "POST",
   "path": "/api/runs/<id>/resume"
  },
  {
   "method": "POST",
   "path": "/api/runs/<id>/stop"
  },
  {
   "method": "POST",
   "path": "/api/runs/<id>/retry"
  },
  {
   "method": "POST",
   "path": "/api/runs/reorder",
   "body": "{order: [run ids of queued runs]}"
  },
  {
   "method": "GET",
   "path": "/api/questions",
   "does": "The open questions of every run, for the Decisions inbox."
  },
  {
   "method": "POST",
   "path": "/api/questions/<id>/answer",
   "body": "{option?, text?}",
   "does": "Records the answer and resumes the run."
  },
  {
   "method": "POST",
   "path": "/api/runs/<id>/accept",
   "body": "{confirm}",
   "does": "accept with person_agreed=true; needs the confirm token from the accept preview."
  },
  {
   "method": "POST",
   "path": "/api/runs/<id>/undo",
   "body": "{confirm}",
   "does": "undo; needs the confirm token from the undo preview."
  }
 ],
 "security": {
  "listen": "127.0.0.1 only; the server refuses to bind any other address.",
  "launch_token": "A random token per server launch (secrets.token_urlsafe(32)), in the URL the server opens (#token=) and sent by the Studio as the header X-EAOS-Token on every API call; compared in constant time (hmac.compare_digest).",
  "csrf": "Every POST carries X-EAOS-CSRF equal to the token GET /api/session returned for this launch; constant-time compare.",
  "origin": "Every POST must carry an Origin (or, if absent, a Referer) of http://127.0.0.1:<port> or http://localhost:<port>; Host must be one of the two as well (DNS rebinding).",
  "confirm": "Irreversible actions and code-changing runs need a single-use confirm token from their preview, valid 10 minutes, bound to the action, the selection and the project (HMAC with the launch token).",
  "log": "Every accepted action is an action event before it runs; every refusal is logged to the server log with its reason (never the token).",
  "network": "Nothing is fetched from or sent to the network by the action API; the assistants are the person's own, started on this computer.",
  "consent": "Running the project's code still needs the one-time run_setup consent; a Fix run without it stops at a question."
 },
