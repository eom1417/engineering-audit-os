{
  "schema_version": 1,
  "analysis": {
    "exclude": [
      "build",
      "tests/fixtures",
      "upstream-src",
      "upstreams"
    ],
    "reason": "مستودعات التثبيت ومجموعة القياس بيانات اختبار للأداة، وليست جزءًا من النظام قيد المراجعة؛ و build/ و upstream-src/ نسخ مبنية أو منسوخة من مصدر آخر، وقياسها يقيس شيئًا آخر."
  },
  "layers": {
