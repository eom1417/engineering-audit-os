{
  "schema_version": 1,
  "analysis": {
    "exclude": [
      "build",
      "tests/fixtures",
      "upstream-src",
      "upstreams"
    ],
    "reason": "مستودعات التثبيت ومجموعة القياس بيانات اختبار للأداة، وليست جزءًا من النظام قيد المراجعة؛ و build/ و upstream-src/ نسخ مبنية أو منسوخة من مصدر آخر، وقياسها يقيس شيئًا آخر."
  },
  "layers": {
    "facts": [
      "eaos/facts/**"
    ],
    "compose": [
      "eaos/compose/**"
    ],
    "runtime": [
      "eaos/runtime/**"
    ],
    "ledger": [
      "eaos/apidiff.py",
      "eaos/ask.py",
      "eaos/baseline.py",
      "eaos/capability.py",
      "eaos/claims.py",
      "eaos/correlate.py",
      "eaos/decisions.py",
      "eaos/delta.py",
      "eaos/discover.py",
      "eaos/dossier.py",
      "eaos/engines_report.py",
      "eaos/evaluation_protocol.py",
      "eaos/identity.py",
      "eaos/impact.py",
      "eaos/load_model.py",
      "eaos/map.py",
      "eaos/outcomes.py",
      "eaos/policy.py",
      "eaos/probes.py",
      "eaos/progress.py",
      "eaos/ranking.py",
      "eaos/semantic.py",
      "eaos/semantic_source.py",
      "eaos/site.py",
      "eaos/sustainability.py",
      "eaos/verify.py"
    ],
    "planning": [
      "eaos/acceptance.py",
      "eaos/canonical_home.py",
      "eaos/decision_bridge.py",
      "eaos/guarantee.py",
      "eaos/plan.py",
      "eaos/remediation_patterns.py",
      "eaos/simulator.py",
      "eaos/target_architecture.py",
      "eaos/transform_plan.py"
    ],
    "orchestration": [
      "eaos/__main__.py",
      "eaos/cli.py",
      "eaos/decision_review.py",
      "eaos/evaluate.py",
      "eaos/pipeline/**",
      "eaos/product_review.py",
      "eaos/views.py",
      "eaos/audit.py",
      "eaos/bundles.py",
      "eaos/executive.py"
    ],
    "core": [
      "eaos/__init__.py",
      "eaos/architecture.py",
      "eaos/audit_records.py",
      "eaos/command_groups.py",
      "eaos/discovery.py",
      "eaos/engagement.py",
      "eaos/sessions.py",
      "eaos/snapshots.py",
      "eaos/surface_records.py",
      "eaos/vocabulary.py",
      "eaos/workflow.py",
      "eaos/workspace.py"
    ],
    "tools": [
      "tools/**",
      "design/**"
    ],
    "tests": [
      "tests/**",
      "examples/**"
    ],
    "engines": [
      "eaos/engines/**"
    ]
  },
  "rules": [
    {
      "deny": {
        "from": "facts",
        "to": "runtime"
      },
      "reason": "الطبقة الحتمية يجب أن تعمل بلا مسار النموذج؛ اعتمادها عليه يكسر eaos map بلا مزوّد"
    },
    {
      "deny": {
        "from": "facts",
        "to": "ledger"
      },
      "reason": "استخراج الحقائق لا يعرف كيف تُفسَّر أو تُعرض"
    },
    {
      "deny": {
        "from": "compose",
        "to": "ledger"
      },
      "reason": "المؤلّف يعرض السجلات فقط ولا يعرف منطق التجميع"
    },
    {
      "deny": {
        "from": "compose",
        "to": "facts"
      },
      "reason": "العرض لا يستخرج حقائق بنفسه"
    },
    {
      "deny": {
        "from": "ledger",
        "to": "planning"
      },
      "reason": "السجل لا يعتمد على ما يخطط انطلاقًا منه؛ عكس هذا الاتجاه أنتج دورة استيراد فعلية"
    },
    {
      "deny": {
        "from": "ledger",
        "to": "orchestration"
      },
      "reason": "السجل لا يستدعي طبقة التنسيق التي تستدعيه"
    },
    {
      "deny": {
        "from": "planning",
        "to": "orchestration"
      },
      "reason": "التخطيط يُستدعى من التنسيق ولا يستدعيه"
    },
    {
      "deny": {
        "from": "runtime",
        "to": "tools"
      },
      "reason": "أدوات التطوير ليست جزءًا من زمن التشغيل"
    },
    {
      "deny": {
        "from": "engines",
        "to": "ledger"
      },
      "reason": "المحوّل ينقل ما قاله المحرك ولا يعرف كيف يُفسَّر أو تُبنى عليه ادعاءات"
    },
    {
      "deny": {
        "from": "engines",
        "to": "facts"
      },
      "reason": "الاتجاه واحد: طبقة الحقائق تستهلك المحوّلات، والعكس يصنع دورة"
    },
    {
      "deny": {
        "from": "engines",
        "to": "planning"
      },
      "reason": "أداة خارجية لا تقرر ما يُصلَح"
    },
    {
      "deny": {
        "from": "engines",
        "to": "compose"
      },
      "reason": "المحوّل لا يعرض شيئًا"
    }
  ]
}