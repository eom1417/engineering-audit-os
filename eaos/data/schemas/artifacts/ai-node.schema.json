{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nodes/<node>/last.json",
  "description": "One AI node's run: what it read (the inputs' digest) and asked (the prompt's digest), which assistant and model answered or that the rules decided alone, the time it took and what it cost, whether it came from the cache, every decision in the shared shape (the decision, its options, the evidence ids it stands on, the confidence, why, the open questions), what the evidence check dropped and why, and where the router sent each subject.",
  "x-artifact": "nodes/<node>/last.json",
  "x-owner": "NS46.T15",
  "type": "object",
  "required": [
    "schema_version",
    "node",
    "kind",
    "state",
    "method",
    "assistant",
    "model",
    "at",
    "inputs",
    "prompt",
    "cached",
    "seconds",
    "cost_usd",
    "why",
    "decisions",
    "dropped",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "ai"
    },
    "state": {
      "type": "string",
      "enum": [
        "decided",
        "rules_only",
        "failed"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "model",
        "rules"
      ]
    },
    "assistant": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "type": "string"
    },
    "inputs": {
      "type": "string"
    },
    "prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cached": {
      "type": "boolean"
    },
    "seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "calls": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "why": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "decision",
          "options",
          "evidence",
          "confidence",
          "why",
          "open_questions",
          "source"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "why": {
            "type": "string"
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "question",
                "options",
                "recommendation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recommendation": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "model",
              "rules"
            ]
          },
          "detail": {
            "type": "object"
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "decision",
          "evidence",
          "why"
        ],
        "properties": {
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "to",
          "when",
          "subjects"
        ],
        "properties": {
          "decision": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 1
    },
    "critique": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
