        "unshare",
        "process"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "quarantined",
              "error"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  }
}
