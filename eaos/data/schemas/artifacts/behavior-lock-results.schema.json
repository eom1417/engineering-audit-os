{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "behavior-lock/results.json",
  "description": "Runtime artifact: the lock suite on the original code. results-after.json (NS20.T1) has the same shape.",
  "x-artifact": "behavior-lock/results.json",
  "x-owner": "NS26.T1",
  "type": "object",
  "required": [
    "schema_version",
    "commit",
    "backend",
    "results"
  ],
