{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "intake.json",
  "description": "What the owner must protect and where they are going: every question answered or on a declared default, and the quality scenarios derived from them.",
  "x-artifact": "intake.json",
  "x-owner": "NS11",
  "type": "object",
  "required": [
    "schema_version",
    "questions",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {},
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "default"
            ]
          },
          "default_reason": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "run_command": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "stimulus",
          "response",
          "measure",
          "source",
          "question_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^QS-[0-9]{3}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "load",
              "latency",
              "availability",
              "privacy",
              "security",
              "recovery",
              "maintainability"
            ]
          },
          "stimulus": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "measure": {
            "type": "object",
            "required": [
              "metric",
              "threshold",
              "unit"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "threshold": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "answer",
              "default"
            ]
          },
          "question_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
