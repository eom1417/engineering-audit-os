          },
          "minItems": 1
        }
      }
    },
    "dast": {
      "type": "object",
      "required": [
        "tool",
        "high",
        "medium"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "high": {
          "type": "integer"
        },
        "medium": {
