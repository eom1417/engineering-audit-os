{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/coverage.json",
  "description": "What EAOS measured for this report and what it has not measured yet: every Studio section with its state, the reason in a stable code, which step of the plan will produce it, and how to produce it. A page with no data shows this instead of \"coming soon\".",
  "x-artifact": "studio/coverage.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "sections",
    "not_measured"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "state",
          "reason",
          "detail",
          "step",
          "count"
        ],
        "properties": {
          "section": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "state": {
            "type": "string",
            "enum": [
              "measured",
              "empty",
              "partial",
              "not_measured",
              "failed"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "written",
              "nothing_found",
              "some_parts_missing",
              "not_built",
              "facts_not_exported",
              "stage_failed",
              "section_error",
              "needs_run",
              "needs_screens"
            ]
          },
          "detail": {
            "type": "string"
          },
          "step": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^NS[0-9]+(\\.T[0-9]+)?$"
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "$ref": "#/$defs/measure"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "state"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "measured",
                    "empty",
                    "partial",
                    "not_measured",
                    "failed"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "not_measured": {
      "$ref": "#/$defs/measure"
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
