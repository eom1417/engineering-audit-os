{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/functions.json",
  "description": "Every function EAOS read, by module: what it is, its signature and summary, who calls it and what it calls, the data it reads and writes, its size and complexity, and the cards on it.",
  "x-artifact": "studio/functions.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "modules",
    "functions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "functions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/path"
          },
          "component": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "functions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "module",
          "kind",
          "lines",
          "complexity",
          "callers",
          "callees"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "module": {
            "$ref": "#/$defs/path"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "function",
              "method",
              "component",
              "hook",
              "handler",
              "class"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "exported": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "lines": {
            "$ref": "#/$defs/measure"
          },
          "complexity": {
            "$ref": "#/$defs/measure"
          },
          "callers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "callees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reads": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/touch"
            }
          },
          "writes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/touch"
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "functions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "measured",
              "empty",
              "partial",
              "not_measured",
              "failed"
            ]
          },
          "functions": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "step",
          "count",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "measured",
              "empty",
              "partial",
              "not_measured",
              "failed"
            ]
          },
          "step": {
            "type": "string",
            "pattern": "^NS[0-9]+(\\.T[0-9]+)?$"
          },
          "count": {
            "$ref": "#/$defs/measure"
          },
          "detail": {
            "type": "object",
            "required": [
              "ar",
              "en"
            ],
            "properties": {
              "ar": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/measure"
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
