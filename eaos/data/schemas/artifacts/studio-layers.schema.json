{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/layers.json",
  "description": "The system in layers (M6): each boundary (what ships to the browser, endpoints and their guards, the data rules, where the business rules live, the boundaries between layers, operations, tests) with its findings, each naming the reference's fix; the layers of the reference type with their files, the endpoint table and the tables, and the questions EAOS could not decide.",
  "x-artifact": "studio/layers.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "type",
    "live",
    "counts",
    "layers",
    "boundaries",
    "questions",
    "endpoints",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "type": {
      "type": [
        "string",
        "null"
      ]
    },
    "live": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/measure"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "responsibility": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "findings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "browser",
              "endpoints",
              "data",
              "rules",
              "layers",
              "operations",
              "tests"
            ]
          },
          "name": {
            "type": "object",
            "required": [
              "en",
              "ar"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule",
                "severity",
                "en",
                "ar",
                "fix_en",
                "fix_ar"
              ],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "en": {
                  "type": "string"
                },
                "ar": {
                  "type": "string"
                },
                "fix_en": {
                  "type": "string"
                },
                "fix_ar": {
                  "type": "string"
                },
                "evidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "live": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "en",
          "ar"
        ],
        "properties": {
          "en": {
            "type": "string"
          },
          "ar": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        },
        "recorded": {
          "type": "boolean"
        },
        "detached": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
