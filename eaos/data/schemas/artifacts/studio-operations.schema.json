{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/operations.json",
  "description": "The ordered operations of the change: what is retained, refactored, rebuilt, merged, deleted or new, on which subject, in which step, after which other operations.",
  "x-artifact": "studio/operations.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "op",
          "subject",
          "subject_kind",
          "reason",
          "order",
          "after",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "retain",
              "refactor",
              "rebuild",
              "merge",
              "delete",
              "new"
            ]
          },
          "subject": {
            "type": "string"
          },
          "subject_kind": {
            "type": "string",
            "enum": [
              "component",
              "module",
              "file",
              "function",
              "table",
              "screen",
              "endpoint"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "plan": {
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "active",
              "done",
              "blocked",
              "regressed"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "assistant",
        "model",
        "at",
        "confidence",
        "departures",
        "open_questions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "rules",
            "planned"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "not_planned",
            "stale",
            "failed"
          ]
        },
        "assistant": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "message": {
          "type": "object",
          "required": [
            "en",
            "ar"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "ar": {
              "type": "string"
            }
          }
        },
        "inputs": {
          "type": [
            "string",
            "null"
          ]
        },
        "departures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_says",
              "plan_chose",
              "because"
            ],
            "properties": {
              "rule_says": {
                "type": "string"
              },
              "plan_chose": {
                "type": "string"
              },
              "because": {
                "type": "string"
              },
              "element": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "recommendation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
