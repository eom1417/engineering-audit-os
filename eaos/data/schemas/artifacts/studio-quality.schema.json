{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/quality.json",
  "description": "How good EAOS's own analysis is for this project: each detector's precision and recall on EAOS's labelled set, whether it meets the bar the product shows it at, what it produced in this report and, for a labelled project, its own true and false positives; the plan's capabilities that judge the analysis and their indicators.",
  "x-artifact": "studio/quality.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "detectors",
    "capabilities",
    "indicators"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "detectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "applies",
          "precision",
          "recall"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "engine": {
            "type": [
              "string",
              "null"
            ]
          },
          "applies": {
            "type": "boolean"
          },
          "precision": {
            "$ref": "#/$defs/ratio_measure"
          },
          "recall": {
            "$ref": "#/$defs/ratio_measure"
          },
          "labelled": {
            "type": [
              "integer",
              "null"
            ]
          },
          "shown": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "meets_bar",
              "below_bar",
              "not_measured"
            ]
          },
          "why": {
            "type": "string"
          },
          "judged": {
            "type": "integer",
            "minimum": 0
          },
          "here": {
            "type": "object",
            "required": [
              "shown",
              "withheld",
              "facts"
            ],
            "properties": {
              "shown": {
                "type": "integer",
                "minimum": 0
              },
              "withheld": {
                "type": "integer",
                "minimum": 0
              },
              "facts": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "project": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "tp": {
                "type": "integer",
                "minimum": 0
              },
              "fp": {
                "type": "integer",
                "minimum": 0
              },
              "unjudged": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "tp",
              "fp",
              "unjudged"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/ratio_measure"
          },
          "measured": {
            "type": "integer",
            "minimum": 0
          },
          "indicators": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/ratio_measure"
          },
          "target": {
            "$ref": "#/$defs/ratio"
          },
          "capability": {
            "type": "string"
          },
          "how": {
            "type": "string",
            "enum": [
              "automated",
              "recorded"
            ]
          }
        }
      }
    },
    "bar": {
      "type": "object",
      "required": [
        "precision",
        "recall",
        "judged"
      ],
      "properties": {
        "precision": {
          "$ref": "#/$defs/ratio"
        },
        "recall": {
          "$ref": "#/$defs/ratio"
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "labelled": {
      "type": "object",
      "required": [
        "items",
        "projects",
        "this_project"
      ],
      "properties": {
        "items": {
          "type": [
            "integer",
            "null"
          ]
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "this_project": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/measure"
      }
    },
    "measured_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
