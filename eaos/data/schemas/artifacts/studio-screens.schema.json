{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/screens.json",
  "description": "What users see: every screen with its route, its shots per viewport before and after each batch, its inputs, and the usability issues found on it, each pinned to a region of the shot.",
  "x-artifact": "studio/screens.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "screens"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "route",
          "title",
          "shots",
          "inputs",
          "issues"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "component": {
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "width"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/path"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "phase": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "before",
                    "after",
                    "baseline",
                    null
                  ]
                },
                "batch": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "type": "string"
                },
                "labelled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "validated": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "required": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rule",
                "severity",
                "summary",
                "state"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "info"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "element": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "width": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "box": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "card": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "open",
                    "fixed"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
