{
  "schema_version": 1,
  "about": "Real data written in the code (M12): what the Presidio scan (eaos/templates/presidio/scan.py, run by eaos/engines/security/presidio.py) counts as a personal value in a string literal, what it takes for a placeholder that must stay, and how a table written as code (eaos/rules/ast-grep data-table rules) is read as records of the domain or as the program's own configuration (eaos/analysis/assessments/real_data.py). Every list here is data, the owner's to change.",
  "suffixes": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".vue", ".svelte", ".py", ".json", ".sql"],
  "skip_names": ["package.json", "package-lock.json", "tsconfig.json", "jsconfig.json", "composer.json", "manifest.json", "components.json", "renovate.json", "vercel.json", "netlify.json", "firebase.json", "app.json", "deno.json", "turbo.json", "lerna.json", "nx.json", "project.json", "angular.json"],
