{
  "semgrep": [
    {
      "match": "generic.secrets.*",
      "kind": "secret",
      "severity_floor": "high"
    },
    {
      "match": "eaos.security.service-role-in-frontend",
      "kind": "secret",
      "severity_floor": "critical"
    },
    {
      "match": "eaos.security.*",
      "kind": "vulnerability"
    },
    {
      "match": "eaos.boundary.*",
      "kind": "boundary"
    },
    {
      "match": "eaos.dataflow.*",
      "kind": "dataflow"
    },
    {
      "match": "eaos.*",
      "kind": "dataflow"
    },
    {
      "match": "*.security.*",
      "kind": "vulnerability"
    }
  ],
  "checkov": [
    {
      "match": "CKV_SECRET_*",
      "kind": "secret",
      "severity_floor": "high"
    },
    {
      "match": "CKV*",
      "kind": "misconfiguration"
    }
  ],
  "osv-scanner": [
    {
      "match": "*",
      "kind": "vulnerability"
    }
  ],
  "spectral": [
    {
      "match": "*",
      "kind": "api_contract"
    }
  ],
  "zap": [
    {
      "match": "*",
      "kind": "vulnerability"
    }
  ],
  "bandit": [
    {
      "match": "B105",
      "kind": "secret"
    },
    {
      "match": "B106",
      "kind": "secret"
    },
    {
      "match": "B107",
      "kind": "secret"
    },
    {
      "match": "B*",
      "kind": "vulnerability"
    }
  ],
  "gitleaks": [
    {
      "match": "*",
      "kind": "secret",
      "severity_floor": "high"
    }
  ],
  "codeql": [
    {
      "match": "*/hardcoded-credentials",
      "kind": "secret"
    },
    {
      "match": "*",
      "kind": "vulnerability"
    }
  ]
}
