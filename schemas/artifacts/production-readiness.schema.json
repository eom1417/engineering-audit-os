{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRODUCTION-READINESS.json",
  "description": "Runtime artifact: every readiness item with the command that decided it.",
  "x-artifact": "PRODUCTION-READINESS.json",
  "x-owner": "NS16.T1",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "ok"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "output": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  }
}
