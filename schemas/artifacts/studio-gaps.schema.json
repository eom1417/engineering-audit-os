{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/gaps.json",
  "description": "The gap register: what separates each component from the ideal, the operation that closes it, and how far it is closed.",
  "x-artifact": "studio/gaps.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "operation",
          "files",
          "cards",
          "cards_closed",
          "closed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "retain",
              "refactor",
              "rebuild",
              "merge",
              "delete",
              "new"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "responsibility": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cards_closed": {
            "type": "integer",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "closed": {
            "$ref": "#/$defs/ratio_measure"
          }
        }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
