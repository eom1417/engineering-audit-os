{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/history.json",
  "description": "The project over time, read from the ledger: every check with its score and open cards by severity (null where the ledger did not record them), the progress of the fixes taken in, the events between checks, and the cards that closed or appeared, so two checks can be compared.",
  "x-artifact": "studio/history.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "scans",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "scans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "score",
          "open"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "open": {
            "type": "object",
            "required": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ],
            "properties": {
              "critical": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "high": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "medium": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "low": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "info": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "open_total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "closed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "added": {
            "type": [
              "integer",
              "null"
            ]
          },
          "resolved": {
            "type": [
              "integer",
              "null"
            ]
          },
          "open_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "event",
          "closed",
          "total",
          "percent"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "closed": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "kind",
          "title"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "scan",
              "batch",
              "merge",
              "decision",
              "release"
            ]
          },
          "title": {
            "type": "string"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "state",
          "new"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "in_batch",
              "on_branch",
              "done",
              "resolved",
              "skipped"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "new": {
            "type": "boolean"
          },
          "batch": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "step",
          "count",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "measured",
              "empty",
              "partial",
              "not_measured",
              "failed"
            ]
          },
          "step": {
            "type": "string",
            "pattern": "^NS[0-9]+(\\.T[0-9]+)?$"
          },
          "count": {
            "$ref": "#/$defs/measure"
          },
          "detail": {
            "type": "object",
            "required": [
              "ar",
              "en"
            ],
            "properties": {
              "ar": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "src": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
