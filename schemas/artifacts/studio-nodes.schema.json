{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/nodes.json",
  "description": "The AI nodes of EAOS's pipeline: each node with its title, the passes it makes, the nodes it waits for, its router's declared branches (the decision, where it sends the work, the condition in plain words, how many subjects took it), how its last run was decided (by which assistant and model, or by the rules alone, and why), its budget and cost, its decisions with their evidence, what the evidence check dropped, and its run log; the questions that wait for the person go to the Decisions inbox.",
  "x-artifact": "studio/nodes.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "nodes",
    "sinks",
    "questions",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "passes",
          "requires",
          "routes",
          "state",
          "method",
          "assistant",
          "model",
          "at",
          "cached",
          "budget",
          "why",
          "decisions",
          "dropped",
          "log"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "object",
            "required": [
              "en",
              "ar"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          },
          "kind": {
            "const": "ai"
          },
          "passes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "decision",
                "to",
                "when",
                "subjects"
              ],
              "properties": {
                "decision": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "when": {
                  "type": "object",
                  "required": [
                    "en",
                    "ar"
                  ],
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "ar": {
                      "type": "string"
                    }
                  }
                },
                "subjects": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "minItems": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "decided",
              "rules_only",
              "failed",
              "not_run"
            ]
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "model",
              "rules",
              null
            ]
          },
          "assistant": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cached": {
            "type": "boolean"
          },
          "seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "budget": {
            "type": "object",
            "required": [
              "seconds",
              "usd"
            ],
            "properties": {
              "seconds": {
                "type": "number"
              },
              "usd": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "subject",
                "decision",
                "options",
                "evidence",
                "confidence",
                "why",
                "open_questions",
                "source"
              ],
              "properties": {
                "subject": {
                  "type": "string"
                },
                "decision": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "why": {
                  "type": "string"
                },
                "open_questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "question",
                      "options",
                      "recommendation"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "question": {
                        "type": "string"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "recommendation": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "model",
                    "rules"
                  ]
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          },
          "dropped": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "subject",
                "decision",
                "evidence",
                "why"
              ],
              "properties": {
                "subject": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "decision": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "log": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "state",
                "model",
                "prompt",
                "inputs",
                "cached"
              ],
              "properties": {
                "at": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "decided",
                    "rules_only",
                    "failed"
                  ]
                },
                "assistant": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prompt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "inputs": {
                  "type": "string"
                },
                "cached": {
                  "type": "boolean"
                },
                "seconds": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cost_usd": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "sinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "object",
            "required": [
              "en",
              "ar"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "ar": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "node",
          "subject",
          "question",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/measure"
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
