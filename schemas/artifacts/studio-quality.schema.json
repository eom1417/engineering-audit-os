{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/quality.json",
  "description": "How good EAOS's own analysis is for this project: each detector's precision and recall on labelled cases, how much of each capability was measured, and the product plan's indicators.",
  "x-artifact": "studio/quality.json",
  "x-owner": "NS46",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "revision",
    "detectors",
    "capabilities",
    "indicators"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "revision": {
      "const": 2
    },
    "detectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "applies",
          "precision",
          "recall"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "engine": {
            "type": [
              "string",
              "null"
            ]
          },
          "applies": {
            "type": "boolean"
          },
          "precision": {
            "$ref": "#/$defs/ratio_measure"
          },
          "recall": {
            "$ref": "#/$defs/ratio_measure"
          },
          "labelled": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/ratio_measure"
          }
        }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/ratio_measure"
          },
          "target": {
            "$ref": "#/$defs/ratio"
          }
        }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "file#field, or the formula, the number comes from"
    },
    "measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "src": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "type": "string",
          "enum": [
            "count",
            "seconds",
            "bytes",
            "lines"
          ]
        }
      }
    },
    "ratio_measure": {
      "type": "object",
      "required": [
        "value",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "src": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!(.*/)?\\.\\.(/|$))"
    },
    "scan": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "at"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "env",
            "network",
            "store",
            "storage"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "x-revision": 2
}
