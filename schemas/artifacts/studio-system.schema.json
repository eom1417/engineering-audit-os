    "provenance": {
      "type": "object",
      "required": [
        "method",
        "assistant",
        "model",
        "at",
        "confidence",
        "departures",
        "open_questions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "rules",
            "planned"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "not_planned",
            "stale",
            "failed"
          ]
        },
        "assistant": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "message": {
          "type": "object",
          "required": [
            "en",
            "ar"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "ar": {
              "type": "string"
            }
          }
        },
        "inputs": {
          "type": [
            "string",
            "null"
          ]
        },
        "departures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_says",
              "plan_chose",
              "because"
