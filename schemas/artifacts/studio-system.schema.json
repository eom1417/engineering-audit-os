                  "medium": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "low": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "op": {
                "type": "string",
                "enum": [
                  "retain",
                  "modify",
                  "rebuild",
                  "delete",
                  "merge",
                  "introduce"
