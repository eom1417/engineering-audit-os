                "type": "object",
                "required": [
                  "x",
                  "y",
                  "anchor",
                  "size",
                  "placed"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "start",
                      "middle",
                      "end"
                    ]
                  },
                  "size": {
                    "type": "number"
                  },
                  "placed": {
                    "type": "boolean"
                  },
                  "big": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
