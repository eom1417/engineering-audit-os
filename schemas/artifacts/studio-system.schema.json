                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "start",
                      "middle",
                      "end"
                    ]
                  },
                  "size": {
                    "type": "number"
                  },
                  "placed": {
                    "type": "boolean"
                  },
                  "big": {
                    "type": "boolean"
                  }
                }
              }
