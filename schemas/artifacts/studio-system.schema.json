      "type": "object",
      "required": [
        "regions",
        "nodes",
        "edges",
        "bounds"
      ],
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "components",
              "files",
              "lead",
              "label",
              "land"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "dir",
                  "rest",
                  "top",
                  "layer"
                ]
              },
              "folder": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "object",
                "required": [
                  "ar",
                  "en",
                  "ident"
                ],
                "properties": {
                  "ar": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  },
                  "ident": {
                    "type": "boolean"
                  }
                }
              },
              "components": {
                "type": "integer",
                "minimum": 0
              },
              "files": {
                "type": "integer",
                "minimum": 0
              },
              "findings": {
