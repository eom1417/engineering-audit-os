{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio/system.json",
  "description": "The project as two territory maps, today and the target: components with their files, findings and operation, the weighted imports between them, and the layout computed by EAOS so the Studio only draws. The precursor of NS39.T1's unified graph.",
  "x-artifact": "studio/system.json",
  "x-owner": "NS36",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "world",
    "counts",
    "operations",
    "src",
    "current",
    "target"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": 1
    },
    "world": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "graph": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "components",
        "regions",
        "edges",
        "imports",
        "target_components",
        "target_edges"
      ],
      "properties": {
        "components": {
          "$ref": "#/$defs/measure"
        },
        "regions": {
          "$ref": "#/$defs/measure"
        },
        "edges": {
          "$ref": "#/$defs/measure"
        },
        "imports": {
          "$ref": "#/$defs/measure"
        },
        "target_components": {
          "$ref": "#/$defs/measure"
        },
        "target_edges": {
          "$ref": "#/$defs/measure"
        },
        "target_regions": {
          "$ref": "#/$defs/measure"
        }
      }
    },
    "operations": {
      "type": "object",
      "required": [
        "retain",
        "modify",
        "rebuild",
        "delete",
        "merge",
        "introduce"
      ],
      "properties": {
        "retain": {
          "$ref": "#/$defs/measure"
        },
        "modify": {
          "$ref": "#/$defs/measure"
        },
        "rebuild": {
          "$ref": "#/$defs/measure"
        },
        "delete": {
          "$ref": "#/$defs/measure"
        },
        "merge": {
          "$ref": "#/$defs/measure"
        },
        "introduce": {
          "$ref": "#/$defs/measure"
        }
      }
    },
    "src": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "capped": {
      "type": "integer",
      "minimum": 0
    },
