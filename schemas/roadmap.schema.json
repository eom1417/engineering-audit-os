{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "tasks",
    "dispositions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "objective",
          "invariant",
          "root_cause",
          "approach",
          "cost",
          "risk",
          "rollback",
          "acceptance_criteria",
          "priority_rationale",
          "finding_ids",
          "evidence_ids",
          "node_ids",
          "scenario_ids",
          "files",
          "steps",
          "alternatives",
          "tests",
          "id",
          "kind",
          "status",
          "priority",
          "depends_on",
          "required_gate_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "string",
            "minLength": 1
          },
          "priority_rationale": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "investigate",
              "remediate"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "implemented",
              "verified"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_gate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "verify_command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Runnable argv that decides the acceptance criterion. Optional for records created before this field existed; required for a task to satisfy the output contract."
          }
        },
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "action",
          "reason",
          "owner",
          "revisit_trigger",
          "evidence_ids"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "defer",
              "no_change"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "revisit_trigger": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
