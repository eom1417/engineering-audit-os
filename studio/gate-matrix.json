{
 "about": "The Studio's routes for the screen gate: python tools/studio_gates.py --studio (studio/README.md). {card} is a problem card with evidence and {component} the component holding the most cards in the report given with --data; {task}, {screen} and {hidden_group}: a journeys task with a path, a flagged screen and an unseen group with items; {store}: the first data store written from more than one place (tools/studio_gates.py).",
 "wait_for": "main#main",
 "variants": [
  {"name": "ar-light", "query": {"lang": "ar", "theme": "light"}, "color_scheme": "light", "expect": {"dir": "rtl", "attributes": {"lang": "ar", "data-theme": "light"}}},
  {"name": "ar-dark", "query": {"lang": "ar", "theme": "dark"}, "color_scheme": "dark", "expect": {"dir": "rtl", "attributes": {"lang": "ar", "data-theme": "dark"}}},
  {"name": "en-light", "query": {"lang": "en", "theme": "light"}, "color_scheme": "light", "expect": {"dir": "ltr", "attributes": {"lang": "en", "data-theme": "light"}}},
  {"name": "en-dark", "query": {"lang": "en", "theme": "dark"}, "color_scheme": "dark", "expect": {"dir": "ltr", "attributes": {"lang": "en", "data-theme": "dark"}}}
 ],
 "viewports": [
  {"name": "phone", "width": 390, "height": 844},
  {"name": "tablet", "width": 768, "height": 1024},
  {"name": "desktop", "width": 1440, "height": 900}
 ],
 "pages": [
  {"name": "gallery", "path": "index.html#/_gallery"},
  {"name": "gallery-matrix", "path": "index.html#/_gallery?view=matrix", "viewports": ["desktop"], "variants": ["ar-light"]},
  {"name": "home", "path": "index.html#/", "height_budget": 2, "lighthouse": true},
  {"name": "system", "path": "index.html#/system"},
  {"name": "system-focus", "path": "index.html#/system?focus={component}"},
  {"name": "system-change", "path": "index.html#/system?view=change"},
  {"name": "system-target", "path": "index.html#/system?view=target&focus=features"},
  {"name": "system-list", "path": "index.html#/system?show=list", "viewports": ["tablet", "desktop"]},
  {"name": "system-hidden", "path": "index.html#/system?hidden=1"},
  {"name": "journeys", "path": "index.html#/system/journeys"},
  {"name": "journeys-change", "path": "index.html#/system/journeys?view=change"},
  {"name": "journeys-target", "path": "index.html#/system/journeys?view=target&hidden=1"},
  {"name": "journeys-task", "path": "index.html#/system/journeys?task={task}"},
  {"name": "journeys-focus", "path": "index.html#/system/journeys?focus={screen}"},
  {"name": "journeys-steps", "path": "index.html#/system/journeys?show=steps", "viewports": ["tablet", "desktop"]},
  {"name": "hidden", "path": "index.html#/system/hidden"},
  {"name": "hidden-focus", "path": "index.html#/system/hidden?focus={hidden_group}"},
  {"name": "data", "path": "index.html#/system/data"},
  {"name": "data-store", "path": "index.html#/system/data?store={store}"},
  {"name": "data-change", "path": "index.html#/system/data?view=change"},
  {"name": "data-target", "path": "index.html#/system/data?view=target"},
  {"name": "data-steps", "path": "index.html#/system/data?show=steps", "viewports": ["tablet", "desktop"]},
  {"name": "system-infra", "path": "index.html#/system?lens=infra"},
  {"name": "system-infra-change", "path": "index.html#/system?lens=infra&view=change"},
  {"name": "system-infra-target", "path": "index.html#/system?lens=infra&view=target&item=target%3Aobservability%3Aobservability"},
  {"name": "system-infra-steps", "path": "index.html#/system?lens=infra&show=steps", "viewports": ["tablet", "desktop"]},
  {"name": "problems", "path": "index.html#/problems", "lighthouse": true},
  {"name": "problem", "path": "index.html#/problems?card={card}"},
  {"name": "change", "path": "index.html#/change"},
  {"name": "change-focus", "path": "index.html#/change?focus={component}", "viewports": ["tablet", "desktop"]},
  {"name": "decisions", "path": "index.html#/decisions"},
  {"name": "paths", "path": "index.html#/system/paths"},
  {"name": "paths-change", "path": "index.html#/system/paths?view=change", "viewports": ["phone", "desktop"]},
  {"name": "flow", "path": "index.html#/flows/{path}"},
  {"name": "flow-target", "path": "index.html#/flows/{path}?view=target&show=diagram", "viewports": ["phone", "desktop"]},
  {"name": "flow-change", "path": "index.html#/flows/{path}?view=change&show=diagram", "viewports": ["phone", "desktop"]},
  {"name": "flow-sequence", "path": "index.html#/flows/{path}?show=sequence"},
  {"name": "flow-steps", "path": "index.html#/flows/{path}?show=steps", "viewports": ["tablet", "desktop"]},
  {"name": "plan-timeline", "path": "index.html#/change/timeline"},
  {"name": "plan-timeline-cell", "path": "index.html#/change/timeline?step=M01&wave=1", "viewports": ["tablet", "desktop"]},
  {"name": "gallery-paths", "path": "index.html#/_gallery/paths"},
  {"name": "pipeline", "path": "index.html#/system/pipeline"},
  {"name": "pipeline-ideal", "path": "index.html#/system/pipeline?view=ideal"},
  {"name": "pipeline-gap", "path": "index.html#/system/pipeline?view=gap"},
  {"name": "pipeline-steps", "path": "index.html#/system/pipeline?show=steps"},
  {"name": "pipeline-stage", "path": "index.html#/system/pipeline?stage={stage}&hidden=1"},
  {"name": "gallery-pipeline", "path": "index.html#/_gallery/pipeline"},
  {"name": "palette", "path": "index.html#/", "actions": [{"press": "Control+k", "wait": 300}, {"type": "مشاكل", "wait": 300}]},
  {"name": "sheet", "path": "index.html#/", "actions": [{"click": "[data-open=\"project\"]", "wait": 400}]},
  {"name": "runs", "path": "index.html#/runs?demo=1"},
  {"name": "runs-snapshot", "path": "index.html#/runs"},
  {"name": "run", "path": "index.html#/runs/demo-5?demo=1"},
  {"name": "run-question", "path": "index.html#/runs/demo-6?demo=1"},
  {"name": "run-snapshot", "path": "index.html#/runs/demo-5", "viewports": ["phone", "desktop"]},
  {"name": "decisions-runs", "path": "index.html#/decisions?demo=1"},
  {"name": "problems-select", "path": "index.html#/problems?demo=1", "actions": [{"click": "input[type=\"checkbox\"]", "wait": 300}]},
  {"name": "preview", "path": "index.html#/problems?demo=1", "actions": [{"click": "input[type=\"checkbox\"]", "wait": 300}, {"click": "[data-verb=\"fix\"]", "wait": 700}]},
  {"name": "preview-snapshot", "path": "index.html#/problems", "actions": [{"click": "input[type=\"checkbox\"]", "wait": 300}, {"click": "[data-verb=\"fix\"]", "wait": 500}], "viewports": ["phone", "desktop"]},
  {"name": "palette-actions", "path": "index.html#/", "actions": [{"press": "Control+k", "wait": 300}, {"type": "audit", "wait": 300}], "viewports": ["phone", "desktop"]},
  {"name": "file-home", "file": "index.html#/", "viewports": ["phone"], "variants": ["ar-light"]}
 ]
}
