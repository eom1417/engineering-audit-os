{
  "name": "eaos-studio",
  "private": true,
  "version": "0.0.0",
  "description": "EAOS Studio: the front end of EAOS, built into eaos/data/studio (docs/STUDIO.md)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run lint && npm run typecheck && npm test && vite build && node scripts/ship.mjs",
    "gates": "../.venv/bin/python ../tools/studio_gates.py --studio"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tanstack/react-router": "1.170.41",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.53.0",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-use-logical": "2.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
